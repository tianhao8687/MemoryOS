{
  "name": "dsh-memoryos",
  "version": "0.1.12",
  "description": "MemoryOS context and usage tools for DeepSeek Harness",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./usage": "./usage.js",
    "./core": "./lib/core.js",
    "./resume": "./lib/resume.js"
  },
  "files": [
    "index.js",
    "usage.js",
    "lib/",
    "scripts/",
    "examples/",
    "cordis.patch.yml",
    "harness-lock.json",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/contract.test.mjs tests/loader-composition.test.mjs",
    "test:contract": "node --test tests/contract.test.mjs",
    "test:loader": "node --test tests/loader-composition.test.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.5",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.5",
    "@deepseek-ai/dsh-session": "0.1.0-rc.5",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.5",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
